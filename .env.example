# SQLite file (relative to prisma/). Use a postgres URL in production.
DATABASE_URL="file:./dev.db"
# Long random string used to sign login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Public URL used when building share links (optional; defaults to request host)
APP_URL="http://localhost:3000"
# First admin account created by `npm run setup`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrator"
